# 环境
.env
.env.*
!.env.example
.venv/
.uv-cache/
.python-version

# 构建产物
build/rag.db
build/runtime_pack.json
build/*.db
build/*.sqlite
build/*.sqlite3
build/runtime_logs/
build/pytest-basetemp/
build/pytest-tmp/
build/pytest-work/
build/eval/**/*.json
build/eval/**/*.jsonl
build/eval/**/*.csv
build/eval/**/*.png
build/eval/**/*.pdf
build/eval/**/*.xlsx
build/eval/**/*.html
build/eval/**/*.log
build/eval/**/*_summary.json
build/eval/perturbation_report.json

# RAIR-RAG paper reproducible artifacts
build/rair_eval/*
!build/rair_eval/
!build/rair_eval/tables/
!build/rair_eval/tables/*.md
!build/rair_eval/tables/*.csv
!build/rair_eval/*_summary.json
!build/rair_eval/runtime_latency_summary.json

# Optional: keep selected full prediction traces for paper trace analysis.
!build/rair_eval/rair_test_risk-router_predictions.jsonl
!build/rair_eval/rair_test_multi_intent_negation_risk-router_predictions.jsonl

# Always ignore archived DE and scratch outputs.
build/rair_eval/de_*
build/rair_eval/*risk-router-de*
build/rair_eval/*risk-router-manual*
build/rair_eval/de_routing/
build/rair_eval/**/*_tmp.*
build/rair_eval/**/*.log

# RAIR-RAG downstream reproducible evaluation artifacts
build/downstream_eval/*
!build/downstream_eval/
!build/downstream_eval/tables/
!build/downstream_eval/tables/*.md
!build/downstream_eval/tables/*.csv
!build/downstream_eval/generation/
!build/downstream_eval/generation/reference/
!build/downstream_eval/generation/local/
!build/downstream_eval/generation/*/*_summary.json
!build/downstream_eval/generation/*/*_manifest.json
!build/downstream_eval/retrieval/
!build/downstream_eval/retrieval/*_summary.json

# Keep large row-level outputs ignored unless explicitly selected.
build/downstream_eval/**/*.jsonl

# Local model weights
models/llm/*.gguf
models/llm/*.bin
models/llm/*.safetensors
build/bert_multilabel/**/*.safetensors
!models/llm/README.md
!models/llm/.gitkeep
dist/
node_modules/
*.egg-info/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd

# 测试与覆盖
.pytest_cache/
.coverage
htmlcov/

# 类型检查与格式化
.mypy_cache/
.ruff_cache/

# IDE
.DS_Store
.idea/
.vscode/
frontend/node_modules/
frontend/dist/
frontend/.npm-cache/
