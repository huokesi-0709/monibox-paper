# ============================================================
# MoniBox 环境配置（示例）
# 复制此文件为 .env 并按需修改
#
# 注意：非机密配置已迁移到 profiles/*.yaml，请优先修改 YAML。
# 本文件仅保留机密信息及机器特定路径。
# ============================================================

# ---------- 机密：API Key ----------
DEEPSEEK_API_KEY=your_key_here

# ---------- 可选：构建期 HuggingFace Token ----------
# HF_TOKEN=hf_xxx

# ---------- 可选：覆盖平台配置 ----------
# RUNTIME_PROFILE=windows
# RUNTIME_CONFIG_PATH=
