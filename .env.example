# MoniBox environment template.
# Copy this file to .env for local development only.
# Keep real credentials out of Git.

DEEPSEEK_API_KEY=<your_deepseek_api_key>

# Optional: Hugging Face token used by local model/build tooling.
# HF_TOKEN=<your_huggingface_token>

# Optional: override runtime profile/config path for local machines.
# RUNTIME_PROFILE=<runtime_profile_name>
# RUNTIME_CONFIG_PATH=<path_to_runtime_config>

# Local LLM generation experiments.
LOCAL_LLM_MODEL_PATH=models/llm/qwen1_5-0_5b-chat-q4_k_m.gguf
LOCAL_LLM_N_CTX=2048
LOCAL_LLM_N_THREADS=4

# Strong reference generator configuration.
# REFERENCE_LLM_BASE_URL=<openai_compatible_base_url>
# REFERENCE_LLM_API_KEY=<your_reference_llm_api_key>
REFERENCE_LLM_PROVIDER=qwen_api
REFERENCE_LLM_MODEL=qwen2.5-7b-instruct
