# ============================================================
# MoniBox-KB 环境配置（示例）
# 复制此文件为 .env 并按需修改
# ============================================================

# ---------- 构建侧：知识库生成流水线 ----------
DEEPSEEK_API_KEY=your_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_CHAT=deepseek-chat
DEEPSEEK_MODEL_REASONER=deepseek-reasoner

EMBEDDING_MODEL=models/embedding/bge-small-zh-v1.5
CHUNK_MAX_CHARS=60
CHUNK_MIN_CHARS=15

RAG_DB_PATH=build/rag.db
RUNTIME_PACK_PATH=build/runtime_pack.json

# ---------- 运行侧：LLM 对话引擎 ----------
# 可选：windows / radxa / text_mvp / voice_mvp / radxa_full / radxa_light / radxa_extreme
RUNTIME_PROFILE=windows

LLM_GGUF_PATH=models/llm/qwen1_5-0_5b-chat-q4_k_m.gguf
LLM_CTX=2048
LLM_THREADS=6
LLM_GPU_LAYERS=0
LLM_CHAT_FORMAT=chatml
LLM_TEMPERATURE=0.3

# RAG 检索参数
RAG_MAX_DISTANCE=0.42
LOW_EVIDENCE_MODE=1

# ---------- 调试开关 ----------
DEBUG_RUNTIME=0
RUNTIME_TRACE_ENABLED=1
RUNTIME_TRACE_PATH=build/runtime_logs/interaction_trace.jsonl

# ---------- 语音链路（阶段 D 当前验证有效的默认值） ----------
TTS_BACKEND=sherpa
TTS_MAX_CHARS=90
TTS_SHERPA_MODEL_DIR=models/tts/sherpa/vits-icefall-zh-aishell3
TTS_SHERPA_MODEL_TYPE=melo
TTS_SHERPA_THREADS=4
TTS_SHERPA_SID=173
TTS_SHERPA_SPEED=0.92
TTS_SHERPA_NOISE_SCALE=0.72
TTS_SHERPA_NOISE_SCALE_W=0.85

REC_SAMPLE_RATE=16000
VAD_START_RMS=0.006
VAD_END_RMS=0.0065
VAD_MIN_RECORD_MS=500
VAD_END_SIL_MS=800
VAD_MAX_SEC=12
VAD_PRE_ROLL_MS=400
ASR_ARM_DELAY_SEC=1.5
ASR_POST_ARM_GUARD_SEC=2.0
